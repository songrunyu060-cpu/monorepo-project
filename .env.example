# ==========================================
# 前端变量：复制到仓库根目录的 .env
# ==========================================

# PC前端
VITE_API_BASE_URL=http://127.0.0.1:8000/api

# 小程序
MINIPROGRAM_API_BASE=http://127.0.0.1:8000/api


# ==========================================
# 后端变量：复制到 apps/video-backend/.env
# （app/core/database.py 与 app/core/cache.py 从该文件读取；
#   生成 openapi.json 时也需要 DATABASE_URL 存在，但不校验真连）
# ==========================================

API_HOST=127.0.0.1
API_PORT=8000

# SQLAlchemy 异步连接串，驱动必须是 aiomysql
DATABASE_URL=mysql+aiomysql://用户名:密码@127.0.0.1:3306/数据库名

# Redis 缓存
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
