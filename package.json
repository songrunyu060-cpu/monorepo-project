{
  "name": "monorepo-project",
  "version": "0.0.1",
  "description": "一个monorepo项目",
  "scripts": {
    "game:dev": "pnpm -F video-game dev",
    "game:build": "pnpm -F video-game build",
    "mgmt:dev": "pnpm -F video-management dev",
    "mgmt:build": "pnpm -F video-management build",
    "api:dev": "cd apps/video-backend && python -m uvicorn app.main:app --reload",
    "api:install": "cd apps/video-backend && uv sync",
    "api:fetch-openapi": "cd apps/video-backend && .venv/bin/python -c \"import json;from app.main import app;print(json.dumps(app.openapi(),ensure_ascii=False))\" > ../../packages/shared-types/openapi.json",
    "api:gen-types": "openapi-typescript packages/shared-types/openapi.json -o packages/shared-types/src/api.ts && pnpm -F @monorepo/shared-types gen:modules",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "typecheck": "tsc --build",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "dev": "turbo dev",
    "build": "turbo build"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "keywords": [
    "monorepo",
    "fastapi"
  ],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.30.3",
  "devDependencies": {
    "@monorepo/tsconfig": "workspace:*",
    "openapi-typescript": "^7.13.0",
    "oxlint": "^1.87.0",
    "prettier": "^3.9.9",
    "turbo": "^2.11.7",
    "typescript": "~6.0.2"
  }
}
